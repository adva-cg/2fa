{
  "manifest_version": 3,
  "name": "2FA Authenticator (local)",
  "description": "Local 2FA codes. Clock check only; account data stays in the browser.",
  "default_locale": "en",
  "version": "1.13.4",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "quick-fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_cmdQuickFill__"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  }
}
